# Copy to .env only for local production-profile experiments. Never commit .env.
RATE_LIMITER_API_KEY=replace-with-a-long-random-service-key
RATE_LIMITER_KEY_HASH_SECRET=replace-with-a-long-random-hmac-key
SPRING_DATA_REDIS_PASSWORD=
GRAFANA_ADMIN_PASSWORD=admin

# Optional localhost port overrides for isolated stacks and browser-visible UI links.
REDIS_PORT=6379
APP_PORT=8080
UI_HOST_PORT=3001
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
