<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>dev.ratelimiter</groupId>
    <artifactId>distributed-rate-limiter</artifactId>
    <version>1.0.0-SNAPSHOT</version>
  </parent>
  <artifactId>rate-limiter-coverage</artifactId>
  <packaging>pom</packaging>
  <name>Rate Limiter :: Aggregate Coverage</name>

  <dependencies>
    <dependency>
      <groupId>dev.ratelimiter</groupId>
      <artifactId>rate-limiter-core</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>dev.ratelimiter</groupId>
      <artifactId>rate-limiter-spring-boot-starter</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.jacoco</groupId>
        <artifactId>jacoco-maven-plugin</artifactId>
        <executions>
          <execution>
            <id>aggregate-report</id>
            <phase>generate-test-resources</phase>
            <goals><goal>report-aggregate</goal></goals>
            <configuration>
              <outputDirectory>${project.build.directory}/site/jacoco-aggregate</outputDirectory>
              <excludes>
                <exclude>**/autoconfigure/**</exclude>
                <exclude>**/config/RateLimiterProperties*</exclude>
                <exclude>**/config/PolicyProperties*</exclude>
              </excludes>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <executions>
          <execution>
            <id>compile-aggregate-coverage-gate</id>
            <phase>test-compile</phase>
            <goals><goal>testCompile</goal></goals>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <executions>
          <execution>
            <id>enforce-aggregate-coverage</id>
            <phase>test</phase>
            <goals><goal>test</goal></goals>
          </execution>
        </executions>
        <configuration>
          <systemPropertyVariables>
            <aggregateCoverageXml>${project.build.directory}/site/jacoco-aggregate/jacoco.xml</aggregateCoverageXml>
          </systemPropertyVariables>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
